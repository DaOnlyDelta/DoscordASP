<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/itemFriendPfp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

    <TextView
        android:id="@+id/itemFriendDisplayName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Display Name"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/itemFriendPfp"
        app:layout_constraintTop_toTopOf="@id/itemFriendPfp" />

    <TextView
        android:id="@+id/itemFriendUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="username"
        android:textColor="@color/textGray"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/itemFriendDisplayName"
        app:layout_constraintStart_toStartOf="@id/itemFriendDisplayName"
        app:layout_constraintTop_toBottomOf="@id/itemFriendDisplayName" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemFriendStatus"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/gray"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintStart_toStartOf="@id/itemFriendPfp"
        app:layout_constraintTop_toTopOf="@id/itemFriendPfp"
        app:strokeColor="#26272f"
        app:strokeWidth="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>