        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:datePickerDialogTheme">@style/MyDatePickerStyle</item>
    </style>

    <style name="MyDatePickerStyle" parent="Theme.AppCompat.Light.Dialog">
