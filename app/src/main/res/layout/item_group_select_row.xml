<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/itemGroupSelectPfp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

    <TextView
        android:id="@+id/itemGroupSelectDisplayName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Display Name"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/itemGroupSelectCard"
        app:layout_constraintStart_toEndOf="@id/itemGroupSelectPfp"
        app:layout_constraintTop_toTopOf="@id/itemGroupSelectPfp" />

    <TextView
        android:id="@+id/itemGroupSelectUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="username"
        android:textColor="@color/textGray"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/itemGroupSelectDisplayName"
        app:layout_constraintStart_toStartOf="@id/itemGroupSelectDisplayName"
        app:layout_constraintTop_toBottomOf="@id/itemGroupSelectDisplayName" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemGroupSelectCard"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/textGray"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/itemGroupSelectCheck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/check"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/itemGroupSelectDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="65dp"
        android:background="#2c2d33"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>