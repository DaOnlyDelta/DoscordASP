<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Doscord">
        <activity
            android:name=".activities.chatroom.AddByUserActivity"
            android:exported="false" />
        <activity
            android:name=".activities.chatroom.AddFriendsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.chatroom.CrMainActivity"
            android:exported="false" />
        <activity
            android:name=".activities.chatroom.CrChatActivity"
            android:exported="false"
            android:parentActivityName=".activities.chatroom.CrMainActivity"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.chatroom.CrMainActivity" />
        </activity>
        <activity
            android:name=".activities.menu.RegPfpActivity"
            android:exported="false" />
        <activity
            android:name=".activities.menu.RegBdayActivity"
            android:exported="false" />
        <activity
            android:name=".activities.menu.RegUserActivity"
            android:exported="false" />
        <activity
            android:name=".activities.menu.RegDisplayActivity"
            android:exported="false"
            android:theme="@style/Theme.Doscord" />
        <activity
            android:name=".activities.menu.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".activities.menu.LoginActivity"
            android:exported="false" />

        <receiver
            android:name=".utils.NotificationDeleteReceiver"
            android:exported="false" />

        <activity
            android:name=".activities.menu.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity
            android:name=".activities.chatroom.CrNewChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>